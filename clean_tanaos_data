import pandas as pd
combined_df_train = pd.read_csv("claude_datasets/combined_train_v3.csv")
print(combined_df_train.category.value_counts())
#%%

# Target maximum for G6
G6_TARGET = 200

# Separate G6 from the other categories
g6_df = combined_df_train[combined_df_train["category"] == "G6"]
other_df = combined_df_train[combined_df_train["category"] != "G6"]

# Randomly sample G6 while preserving its diversity
g6_sampled = g6_df.sample(
    n=G6_TARGET,
    random_state=42
)

# Recombine and shuffle
train_df_balanced = pd.concat(
    [other_df, g6_sampled],
    ignore_index=True
).sample(
    frac=1,
    random_state=42
).reset_index(drop=True)

print(train_df_balanced["category"].value_counts())
print(train_df_balanced["labels"].value_counts())
#%%
# save the balanced dataset
train_df_balanced.to_csv("claude_datasets/combined_train_v4_balanced.csv", index=False)
